transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 111.38, 25.05, 8.69)
script = ExtResource("gp_pickup")
kind = 0
journal_text = "Torn loose-leaf, wedged under a vent cap: 'Between the towers you can see the whole route back down. It doesn't look this far when you're walking it.'"
