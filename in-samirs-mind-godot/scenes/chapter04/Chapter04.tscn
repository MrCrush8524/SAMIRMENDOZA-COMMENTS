transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.0, 9.2, 10.0)
script = ExtResource("gp_pickup")
kind = 0
journal_text = "Samir's handwriting, cramped in the margin: 'The roofs go higher than the block does. I checked twice.'"
item_id = "6"
