transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 70.4, 25.05, -4.31)
script = ExtResource("gp_pickup")
kind = 0
journal_text = "A page stuck to the tarpaper by old rain: 'Found the south roof. Nobody uses it. I don't think anyone else knows it's here.'"
