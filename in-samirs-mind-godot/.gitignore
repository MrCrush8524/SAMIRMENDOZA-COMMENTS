# Godot 4 local import cache — regenerated on first open/run.
# .import files themselves ARE committed (Godot convention): they're
# small resource metadata, not the cache itself.
.godot/

# Export builds
export/
build/
*.exe
*.apk
*.aab
*.pck

# Samir's raw human-character source package (Reallusion CC4 export): a
# 207MB FBX plus ~525MB of uncompressed BMP textures. Kept on disk per the
# "preserve source untouched" requirement, but never committed - it would
# repeat the exact GitHub-file-size problem the laundromat/cyberpunk_city
# GLBs already hit once (see the commit that shrank those). The derived,
# actually-imported game-ready character goes in
# assets/characters/game_ready/ instead, which IS tracked normally.
assets/characters/source/samir_human/
