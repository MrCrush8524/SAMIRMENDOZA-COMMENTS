{
  "name": "the-backrooms",
  "productName": "The Backrooms",
  "version": "1.0.0",
  "description": "A walkable, dreamcore-pastel recreation of the Backrooms wiki blueprint.",
  "main": "main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.thebackrooms",
    "productName": "The Backrooms",
    "directories": { "output": "dist" },
    "files": ["main.js", "app/**/*"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
